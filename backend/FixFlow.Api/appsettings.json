{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=FixFlow;Username=postgres;Password="
  },
  "Jwt": {
    "Issuer": "FixFlow",
    "Audience": "FixFlowClients",
    "Secret": "FixFlowLocalDevJwtSecretKey_ChangeBeforeProduction!",
    "ExpiryMinutes": 60,
    "RefreshExpiryDays": 7
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Ai": {
    "Provider": "Deterministic",
    "MaxPromptChars": 4000,
    "MaxOutputChars": 8000,
    "MaxRetries": 2,
    "ToolTimeoutSeconds": 8
  },
  "Maps": {
    "Provider": "Nominatim",
    "BaseUrl": "https://nominatim.openstreetmap.org",
    "ApiKey": "",
    "UserAgent": "FixFlowAI/1.0 (university-project)",
    "TimeoutSeconds": 5,
    "MaxRetries": 2,
    "RetryDelayMilliseconds": 400
  }
}
