# FixFlow environment template
# Copy this file to .env and fill in local values.

# --- API ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
JWT_ISSUER=FixFlow
JWT_AUDIENCE=FixFlowClients
JWT_SECRET=FixFlowLocalDevJwtSecretKey_ChangeBeforeProduction!

# --- Database (pgAdmin 4 / local PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=FixFlow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-local-postgres-password
CONNECTION_STRING=Host=localhost;Port=5432;Database=FixFlow;Username=postgres;Password=your-local-postgres-password

# --- Web ---
VITE_API_BASE_URL=http://localhost:5080

# --- Mobile ---
API_BASE_URL=http://localhost:5080
